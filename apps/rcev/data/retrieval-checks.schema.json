{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "bankId",
    "chapterId",
    "sources",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "bankId": {
      "type": "string",
      "minLength": 1
    },
    "chapterId": {
      "const": "all"
    },
    "sources": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "minItems": 80,
      "maxItems": 120,
      "items": {
        "type": "object",
        "required": [
          "id",
          "chapterId",
          "videoId",
          "sequence",
          "type",
          "prompt",
          "choices",
          "correctChoiceId",
          "explanation",
          "concept",
          "provenance",
          "editorialStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ch[1-5]-v0[1-8]-check-0[1-3]$"
          },
          "chapterId": {
            "type": "string",
            "pattern": "^ch[1-5]$"
          },
          "videoId": {
            "type": "string",
            "pattern": "^ch[1-5]-v0[1-8]$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "type": {
            "enum": [
              "multiple-choice",
              "short-selected-response"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 10
          },
          "choices": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "correctChoiceId": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 20
          },
          "concept": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sourceId",
                "locator",
                "support"
              ],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "support": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "editorialStatus": {
            "enum": [
              "approved-for-iteration-8-pilot",
              "approved-for-iteration-9"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
