{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCE Video Lab Scenario Bank",
  "type": "object",
  "required": [
    "schemaVersion",
    "appVersion",
    "title",
    "disclaimer",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "appVersion": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "disclaimer": {
      "type": "string"
    },
    "scenarios": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "chapterId",
          "chapterNumber",
          "title",
          "mode",
          "modeLabel",
          "summary",
          "scenario",
          "instructions",
          "rubric",
          "provenance",
          "editorialStatus"
        ],
        "additionalProperties": true
      }
    }
  }
}
