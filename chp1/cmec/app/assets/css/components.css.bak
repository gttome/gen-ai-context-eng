.status-pill-row,
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.status-pill,
.tag,
.metric-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  min-height: 2rem;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.05);
  color: var(--text);
  font-size: 0.88rem;
}

.status-pill strong {
  font-size: 0.83rem;
}

.primary-btn,
.ghost-btn,
.action-btn,
.toggle-btn {
  min-height: 2.7rem;
  border-radius: 999px;
  border: 1px solid transparent;
  padding: 0.65rem 1rem;
  transition: transform 120ms ease, background 120ms ease, border-color 120ms ease, opacity 120ms ease;
}

.primary-btn:hover,
.ghost-btn:hover,
.action-btn:hover,
.toggle-btn:hover {
  transform: translateY(-1px);
}

.primary-btn {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #062033;
  font-weight: 700;
  text-decoration: none;
}

.ghost-btn,
.toggle-btn {
  background: rgba(255,255,255,0.04);
  color: var(--text);
  border-color: var(--border);
}

.action-btn {
  background: rgba(56, 199, 216, 0.12);
  border-color: rgba(56, 199, 216, 0.35);
  color: var(--text);
}

.action-btn.active {
  background: rgba(71, 208, 140, 0.16);
  border-color: rgba(71, 208, 140, 0.5);
}

.hero-card {
  padding: 1.25rem;
  border-radius: var(--radius-xl);
  background: linear-gradient(160deg, rgba(11, 34, 61, 0.95), rgba(6, 16, 31, 0.95));
  border: 1px solid rgba(120, 240, 214, 0.18);
  box-shadow: var(--shadow);
}

.scenario-card,
.component-card,
.metric-card,
.compare-card {
  background: rgba(255,255,255,0.035);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 0.95rem;
}

.scenario-card {
  display: grid;
  gap: 0.9rem;
}

.scenario-card header,
.component-card header,
.metric-card header,
.compare-card header {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: start;
}

.scenario-card .family-title {
  font-size: 1.05rem;
  margin-bottom: 0.25rem;
}

.kv-list {
  display: grid;
  gap: 0.7rem;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: center;
}

.kv-row dt {
  color: var(--muted);
}

.kv-row dd {
  margin: 0;
  font-weight: 600;
  text-align: right;
}

.prediction-list,
.repair-list {
  display: grid;
  gap: 0.65rem;
}

.prediction-option {
  display: grid;
  gap: 0.3rem;
  padding: 0.75rem;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: rgba(255,255,255,0.03);
}

.prediction-option input {
  margin-right: 0.45rem;
}

.component-card .component-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.component-card.included {
  border-color: rgba(71, 208, 140, 0.55);
  background: rgba(71, 208, 140, 0.08);
}

.component-card.excluded {
  opacity: 0.88;
}

.component-card.recommended {
  box-shadow: inset 0 0 0 1px rgba(120, 240, 214, 0.2);
}

.component-card.noise.included {
  border-color: rgba(255, 191, 94, 0.45);
  background: rgba(255, 191, 94, 0.08);
}

.component-card .content-block,
.copy-block,
.output-block {
  margin-top: 0.8rem;
  padding: 0.8rem;
  border-radius: 16px;
  background: rgba(255,255,255,0.04);
  border: 1px dashed rgba(255,255,255,0.12);
  white-space: pre-wrap;
}

.metric-card .metric-value-row {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 1rem;
}
.metric-card .metric-value {
  font-size: 1.65rem;
  font-weight: 800;
}
.metric-card .metric-delta {
  font-size: 0.95rem;
  font-weight: 700;
}

.progress-shell {
  display: grid;
  gap: 0.6rem;
}

.progress-bar {
  height: 0.85rem;
  background: rgba(255,255,255,0.08);
  border-radius: 999px;
  overflow: hidden;
}

.progress-bar > span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
}

.summary-callout {
  padding: 0.85rem 0.95rem;
  border-radius: 16px;
  background: rgba(56, 199, 216, 0.1);
  border: 1px solid rgba(56, 199, 216, 0.22);
}

.warning-callout {
  background: rgba(255, 191, 94, 0.1);
  border-color: rgba(255, 191, 94, 0.28);
}

.success-callout {
  background: rgba(71, 208, 140, 0.12);
  border-color: rgba(71, 208, 140, 0.28);
}

textarea,
input[type="text"] {
  width: 100%;
  border-radius: 16px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.04);
  color: var(--text);
  padding: 0.85rem 0.95rem;
}

details {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 0.8rem 0.9rem;
  background: rgba(255,255,255,0.035);
}

details > summary {
  cursor: pointer;
  font-weight: 700;
  color: var(--text);
}

.legend-list {
  display: grid;
  gap: 0.5rem;
  margin-top: 0.75rem;
}

.legend-row {
  display: flex;
  align-items: center;
  gap: 0.55rem;
}

.legend-swatch {
  width: 0.9rem;
  height: 0.9rem;
  border-radius: 999px;
}

.glossary-list {
  display: grid;
  gap: 0.8rem;
}

.glossary-term {
  padding-bottom: 0.75rem;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.icon-dot {
  width: 0.7rem;
  height: 0.7rem;
  border-radius: 999px;
  background: currentColor;
}

.footer-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0.75rem;
  margin-top: 1rem;
}

.inline-code-note {
  font-size: 0.92rem;
  color: var(--muted);
}

.hero-card,
.hero-card h1,
.hero-card h2,
.hero-card h3,
.hero-card strong {
  color: #f3fbff;
}

.hero-card .lede,
.hero-card .small-muted,
.hero-card p,
.hero-card li {
  color: rgba(243, 251, 255, 0.88);
}

.hero-card .status-pill,
.hero-card .tag,
.hero-card .metric-tag {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.18);
  color: #f3fbff;
}

.hero-card .ghost-btn {
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.18);
}

.hero-card .summary-callout {
  background: rgba(14, 52, 72, 0.48);
  border-color: rgba(120, 240, 214, 0.28);
}

.hero-card-launcher {
  display: grid;
  gap: 1rem;
}

.hero-copy {
  display: grid;
  gap: 0.75rem;
}

.hero-pill-row {
  margin-top: 0.25rem;
}

.hero-coach-grid,
.coach-grid,
.package-snapshot-grid,
.package-columns,
.compare-summary-grid,
.prediction-hints-grid {
  display: grid;
  gap: 1rem;
}

.coach-card,
.hint-card,
.snapshot-card,
.package-column {
  padding: 0.95rem;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.04);
}

.hero-card .coach-card {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.16);
}

.coach-card strong,
.hint-card strong,
.snapshot-card h3,
.package-column h3,
.package-column-header h3 {
  display: block;
  margin-bottom: 0.45rem;
}

.coach-callout {
  height: 100%;
}

.inline-launch-note {
  max-width: 24rem;
}

.compact-list {
  margin-bottom: 0;
}

.flow-strip {
  display: grid;
  gap: 0.65rem;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
}

.flow-step {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  padding: 0.8rem 0.9rem;
  border-radius: 18px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.03);
  color: var(--text-soft);
}

.flow-step strong {
  display: inline-grid;
  place-items: center;
  width: 1.9rem;
  height: 1.9rem;
  border-radius: 999px;
  background: rgba(255,255,255,0.08);
  color: var(--text);
}

.flow-step.is-active {
  border-color: rgba(56, 199, 216, 0.42);
  background: rgba(56, 199, 216, 0.08);
}

.snapshot-card-muted {
  background: rgba(255,255,255,0.025);
}

.snapshot-list {
  display: grid;
  gap: 0.8rem;
}

.snapshot-item {
  padding: 0.8rem;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.03);
}

.snapshot-item.is-included {
  border-color: rgba(71, 208, 140, 0.32);
  background: rgba(71, 208, 140, 0.06);
}

.snapshot-item.is-missing-recommended {
  border-color: rgba(255, 191, 94, 0.35);
  background: rgba(255, 191, 94, 0.08);
}

.snapshot-item.is-missing-optional {
  border-style: dashed;
}

.snapshot-item-header,
.package-column-header {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 1rem;
}

.package-column {
  display: grid;
  gap: 0.9rem;
}

.package-column .card-grid {
  align-content: start;
}

.prediction-option:has(input:checked) {
  border-color: rgba(56, 199, 216, 0.45);
  background: rgba(56, 199, 216, 0.08);
}

@media (min-width: 760px) {
  .hero-card-launcher {
    grid-template-columns: 1.15fr 0.95fr;
    align-items: start;
  }

  .hero-resume-card {
    grid-column: 1 / -1;
  }

  .hero-coach-grid,
  .coach-grid,
  .compare-summary-grid,
  .prediction-hints-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .package-snapshot-grid,
  .package-columns {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
