{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./catalog.schema.json",
  "title": "RCE Video 1.0 catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app",
    "chapterCount",
    "videoCount",
    "totalDurationSeconds",
    "hosting",
    "mediaAccessibility",
    "chapters",
    "progress"
  ],
  "properties": {
    "app": {
      "type": "object",
      "required": [
        "name",
        "version",
        "iteration",
        "status"
      ],
      "additionalProperties": true
    },
    "sourceAssessmentDate": {
      "type": "string"
    },
    "chapterCount": {
      "const": 5
    },
    "videoCount": {
      "const": 40
    },
    "totalDurationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "totalDurationLabel": {
      "type": "string"
    },
    "hosting": {
      "type": "object",
      "required": [
        "strategy",
        "mediaOrigin",
        "pathPolicy",
        "packageMode",
        "mediaInstallPath",
        "deploymentPreparation",
        "primaryDeployment"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "const": "github-pages-direct"
        },
        "mediaOrigin": {
          "const": "same-origin"
        },
        "pathPolicy": {
          "const": "repository-subpath-safe-relative-paths"
        },
        "packageMode": {
          "const": "application-only-copy-media-folder"
        },
        "mediaInstallPath": {
          "const": "site/media"
        },
        "deploymentPreparation": {
          "const": "generated-deploy-folder"
        },
        "primaryDeployment": {
          "const": "github-desktop-main-branch-root"
        }
      }
    },
    "mediaAccessibility": {
      "type": "object",
      "required": [
        "captionsIncluded",
        "transcriptsIncluded",
        "decision"
      ],
      "additionalProperties": false,
      "properties": {
        "captionsIncluded": {
          "const": false
        },
        "transcriptsIncluded": {
          "const": false
        },
        "decision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sequenceDecisions": {
      "type": "object"
    },
    "chapter2FigureDecision": {
      "type": "object"
    },
    "chapters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "progress": {
      "type": "object",
      "required": [
        "storage",
        "schemaVersion",
        "manualCompletion",
        "automaticCompletionThreshold",
        "resumePositions",
        "cloudSync",
        "bookmarksAndNotes"
      ],
      "additionalProperties": false,
      "properties": {
        "storage": {
          "const": "browser-localStorage-with-session-fallback"
        },
        "schemaVersion": {
          "const": 4
        },
        "manualCompletion": {
          "const": true
        },
        "automaticCompletionThreshold": {
          "const": 0.9
        },
        "resumePositions": {
          "const": true
        },
        "cloudSync": {
          "const": false
        },
        "bookmarksAndNotes": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceName",
        "path",
        "type",
        "bytes",
        "sha256",
        "status"
      ],
      "properties": {
        "sourceName": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^\\./media/ch[1-5]/v0[1-8]\\.(mp4|png)$"
        },
        "type": {
          "enum": [
            "video/mp4",
            "image/png"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "videoCodec": {
          "type": "string"
        },
        "audioCodec": {
          "type": "string"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "integrated"
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chapterId",
        "sequence",
        "title",
        "description",
        "durationSeconds",
        "media",
        "figure",
        "contentStatus",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ch[1-5]-v0[1-8]$"
        },
        "chapterId": {
          "type": "string",
          "pattern": "^ch[1-5]$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "concept": {
          "type": [
            "string",
            "null"
          ]
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "durationLabel": {
          "type": "string"
        },
        "media": {
          "$ref": "#/$defs/asset"
        },
        "figure": {
          "$ref": "#/$defs/asset"
        },
        "contentStatus": {
          "const": "integrated"
        },
        "version": {
          "const": "0.3.0"
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "summary",
        "videoCount",
        "durationSeconds",
        "videos"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ch[1-5]$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "videoCount": {
          "const": 8
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "durationLabel": {
          "type": "string"
        },
        "videos": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/video"
          }
        }
      }
    }
  }
}
